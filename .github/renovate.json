{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "ignorePresets": [
    "docker:pinDigests"
  ],
  "prHourlyLimit": 4,
  "automerge": true,
  "platformAutomerge": true,
  "labels": [
    "dependencies"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Pin production Dockerfile images by digest and merge after CI passes",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["/^Dockerfile$/"],
      "pinDigests": true,
      "platformAutomerge": false
    },
    {
      "description": "Group non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Group non-major Go module updates",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "go dependencies (non-major)"
    }
  ]
}
